ngx_addon_name=ngx_http_tile_module

if test -n "$ngx_module_link"; then

    ngx_module_type=HTTP
    ngx_module_name=ngx_http_tile_module
    ngx_module_incs="$ngx_addon_dir/src $ngx_addon_dir/vendor"
    ngx_module_deps="$ngx_addon_dir/src/ngx_mod_tile.h \
                      $ngx_addon_dir/src/tile_config.h \
                      $ngx_addon_dir/src/tile_store.h \
                      $ngx_addon_dir/src/tile_renderd.h \
                      $ngx_addon_dir/src/tile_serve.h \
                      $ngx_addon_dir/src/tile_response.h \
                      $ngx_addon_dir/src/tile_endpoints.h \
                      $ngx_addon_dir/src/tile_stats.h \
                      $ngx_addon_dir/src/tile_delaypool.h \
                    $ngx_addon_dir/src/tile_thread.h \
                      $ngx_addon_dir/src/tile_stats_shm.h \
                      $ngx_addon_dir/src/tile_delaypool_shm.h \
                      $ngx_addon_dir/vendor/tile_compat.h \
                      $ngx_addon_dir/vendor/config.h \
                      $ngx_addon_dir/vendor/glib_compat.h \
                      $ngx_addon_dir/vendor/g_logger.h \
                      $ngx_addon_dir/vendor/protocol.h \
                      $ngx_addon_dir/vendor/store.h \
                      $ngx_addon_dir/vendor/store_file.h \
                      $ngx_addon_dir/vendor/store_file_utils.h \
                      $ngx_addon_dir/vendor/store_null.h \
                      $ngx_addon_dir/vendor/metatile.h \
                      $ngx_addon_dir/vendor/render_config.h \
                      $ngx_addon_dir/vendor/sys_utils.h \
                      $ngx_addon_dir/vendor/dictionary.h \
                      $ngx_addon_dir/vendor/iniparser.h"
    ngx_module_srcs="$ngx_addon_dir/src/ngx_mod_tile.c \
                      $ngx_addon_dir/src/tile_config.c \
                      $ngx_addon_dir/src/tile_store.c \
                      $ngx_addon_dir/src/tile_renderd.c \
                      $ngx_addon_dir/src/tile_serve.c \
                      $ngx_addon_dir/src/tile_response.c \
                      $ngx_addon_dir/src/tile_endpoints.c \
                      $ngx_addon_dir/src/tile_stats.c \
                      $ngx_addon_dir/src/tile_delaypool.c \
                    $ngx_addon_dir/src/tile_thread.c \
                      $ngx_addon_dir/vendor/store.c \
                      $ngx_addon_dir/vendor/store_file.c \
                      $ngx_addon_dir/vendor/store_file_utils.c \
                      $ngx_addon_dir/vendor/store_null.c \
                      $ngx_addon_dir/vendor/sys_utils.c \
                      $ngx_addon_dir/vendor/g_logger_ngx.c \
                      $ngx_addon_dir/vendor/iniparser.c \
                      $ngx_addon_dir/vendor/dictionary.c"
    # optional storage backends, enabled at configure time with env vars:
    #   NGX_TILE_WITH_MEMCACHED=yes    (needs libmemcached-dev)
    #   NGX_TILE_WITH_RADOS=yes        (needs librados-dev / ceph)
    #   NGX_TILE_WITH_RO_HTTP_PROXY=yes (needs libcurl-dev)
    #   NGX_TILE_WITH_COMPOSITE=yes    (needs libcairo-dev)
    ngx_tile_libs=""

    if [ "$NGX_TILE_WITH_MEMCACHED" = yes ]; then
        have=NGX_TILE_WITH_MEMCACHED . auto/have
        have=HAVE_LIBMEMCACHED . auto/have
        ngx_module_srcs="$ngx_module_srcs $ngx_addon_dir/vendor/store_memcached.c"
        ngx_module_deps="$ngx_module_deps $ngx_addon_dir/vendor/store_memcached.h"
        ngx_tile_libs="$ngx_tile_libs -lmemcached"
        echo " + ngx_mod_tile: memcached storage backend enabled"
    fi

    if [ "$NGX_TILE_WITH_RADOS" = yes ]; then
        have=NGX_TILE_WITH_RADOS . auto/have
        have=HAVE_LIBRADOS . auto/have
        ngx_module_srcs="$ngx_module_srcs $ngx_addon_dir/vendor/store_rados.c"
        ngx_module_deps="$ngx_module_deps $ngx_addon_dir/vendor/store_rados.h"
        ngx_tile_libs="$ngx_tile_libs -lrados"
        echo " + ngx_mod_tile: rados storage backend enabled"
    fi

    if [ "$NGX_TILE_WITH_RO_HTTP_PROXY" = yes ]; then
        have=NGX_TILE_WITH_RO_HTTP_PROXY . auto/have
        have=HAVE_LIBCURL . auto/have
        ngx_module_srcs="$ngx_module_srcs $ngx_addon_dir/vendor/store_ro_http_proxy.c"
        ngx_module_deps="$ngx_module_deps $ngx_addon_dir/vendor/store_ro_http_proxy.h"
        ngx_tile_libs="$ngx_tile_libs -lcurl"
        echo " + ngx_mod_tile: ro_http_proxy storage backend enabled"
    fi

    if [ "$NGX_TILE_WITH_COMPOSITE" = yes ]; then
        have=NGX_TILE_WITH_COMPOSITE . auto/have
        have=NGX_TILE_WITH_RO_COMPOSITE . auto/have
        have=HAVE_CAIRO . auto/have
        ngx_module_srcs="$ngx_module_srcs $ngx_addon_dir/vendor/store_ro_composite.c"
        ngx_module_deps="$ngx_module_deps $ngx_addon_dir/vendor/store_ro_composite.h"
        ngx_tile_libs="$ngx_tile_libs -lcairo"
        echo " + ngx_mod_tile: ro_composite storage backend enabled"
    fi

    ngx_module_libs="$ngx_tile_libs"

    . auto/module

else

    ngx_module_type=HTTP
    ngx_module_name=ngx_http_tile_module

    # static build fallback (--add-module)
    HTTP_MODULES="$HTTP_MODULES ngx_http_tile_module"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS \
                    $ngx_addon_dir/src/ngx_mod_tile.c \
                    $ngx_addon_dir/src/tile_config.c \
                    $ngx_addon_dir/src/tile_store.c \
                    $ngx_addon_dir/src/tile_renderd.c \
                    $ngx_addon_dir/src/tile_serve.c \
                    $ngx_addon_dir/src/tile_response.c \
                    $ngx_addon_dir/src/tile_endpoints.c \
                    $ngx_addon_dir/src/tile_stats.c \
                    $ngx_addon_dir/src/tile_delaypool.c \
                    $ngx_addon_dir/src/tile_thread.c \
                    $ngx_addon_dir/vendor/store.c \
                    $ngx_addon_dir/vendor/store_file.c \
                    $ngx_addon_dir/vendor/store_file_utils.c \
                    $ngx_addon_dir/vendor/store_null.c \
                    $ngx_addon_dir/vendor/sys_utils.c \
                    $ngx_addon_dir/vendor/g_logger_ngx.c \
                    $ngx_addon_dir/vendor/iniparser.c \
                    $ngx_addon_dir/vendor/dictionary.c"
    HTTP_INCS="$HTTP_INCS $ngx_addon_dir/src $ngx_addon_dir/vendor"
    NGX_ADDON_DEPS="$NGX_ADDON_DEPS \
                    $ngx_addon_dir/src/ngx_mod_tile.h \
                    $ngx_addon_dir/src/tile_config.h \
                    $ngx_addon_dir/src/tile_store.h \
                    $ngx_addon_dir/src/tile_renderd.h \
                    $ngx_addon_dir/src/tile_serve.h \
                    $ngx_addon_dir/src/tile_response.h \
                    $ngx_addon_dir/src/tile_endpoints.h"

fi
